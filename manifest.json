{
  "manifest_version": 3,
  "name": "Attention, please!",
  "version": "0.1.0",
  "description": "You clicked it. Now live with it.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "ai-client.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "attention-please@malfunction.hackathon"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Attention, please!"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": [
        "video-context.js",
        "state.js",
        "modal.js",
        "feed.js",
        "content.js",
        "lockouts.js"
      ],
      "run_at": "document_start"
    }
  ]
}